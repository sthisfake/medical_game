# ---------------------------------------------------------------
# کپی کنید به `.env.local` (محلی) یا متغیر محیطی Vercel
# ---------------------------------------------------------------

# --- دیتابیس ---
# اگر تنظیم نشود، برنامه محلی از SQLite (data/game.db) استفاده می‌کند.
# روی Vercel حتماً این متغیر را از پروژهٔ Neon کپی کنید (الزامی است).
DATABASE_URL=

# مثال رشتهٔ اتصال Neon:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
